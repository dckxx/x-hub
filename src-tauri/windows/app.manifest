<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  cargo test 专用：测试 exe 不经 tauri-build 对 bin 目标的 manifest 嵌入，
  而 tauri/wry 导入的 comctl32!TaskDialogIndirect 只存在于 Common-Controls v6
  程序集，缺激活上下文时测试进程启动即死（STATUS_ENTRYPOINT_NOT_FOUND）。
  由 scripts/cargo-test.ps1 在 cargo test 的 no-run 模式后用 SDK mt.exe 嵌入
  本文件（cargo:rustc-link-arg-tests 不覆盖 lib 单元测试，链接器路线已放弃）。
  注意：本文件是 XML，注释里禁止出现连续两个连字符（mt c1010070），措辞需避开。
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0" processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>
</assembly>
